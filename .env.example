# ==============================================================================
# Unified Profile Summary Cards Configuration
# Copy this file to .env and configure your values. NEVER commit .env to git.
# ==============================================================================

# Mode: github | gitlab | combined
PROVIDER=combined

# GitHub Configuration (required if PROVIDER is github or combined)
GITHUB_USERNAME=n1lsqn
GITHUB_TOKEN=ghp_dummyGitHubPersonalAccessToken1234567890

# GitLab Configuration (required if PROVIDER is gitlab or combined)
GITLAB_USERNAME=n1lsqn
GITLAB_BASE_URL=https://gitlab.example.com
# GitLab PAT requires 'read_api' scope
GITLAB_TOKEN=glpat-dummyGitLabPersonalAccessToken1234567890
GITLAB_INCLUDE_PRIVATE=true

# Optional Display & Theme Settings
UTC_OFFSET=9
THEME=github_dark
ANIMATION=none
DURATION=3
DISPLAY_NAME=n1l

# Optional Filters & Limits
EXCLUDE_LANGUAGES=HTML,CSS
EXCLUDE_PROJECTS=user/test,group/archive
OUTPUT_DIR=profile-summary-card-output
TIME_RANGE_DAYS=365
FAIL_ON_PARTIAL_ERROR=false
LOG_LEVEL=info

# Combined Deduplication Settings
DEDUPE_MODE=none
DEDUPE_PREFER=github
# REPOSITORY_DEDUPE_MAP={"user/repo": "group/mirror-repo"}
PROFILE_AVATAR_SOURCE=github

# Local testing flag (allow http for non-TLS test servers)
ALLOW_INSECURE_HTTP=false
